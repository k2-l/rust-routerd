#!/bin/sh /etc/rc.common
# routerd - high performance router management daemon
# Copyright (C) 2026 routerd project

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/routerd
CONF=routerd

start_service() {
	config_load "$CONF"
	local enabled http https tls data_dir
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0
	config_get http main http "0.0.0.0:80"
	config_get https main https "0.0.0.0:443"
	config_get_bool tls main tls 1
	config_get data_dir main data_dir "/etc/routerd"

	mkdir -p "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG" --http "$http" --https "$https" --data-dir "$data_dir"
	[ "$tls" = "1" ] || procd_append_param command --no-tls
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param file "$data_dir/cert.pem" "$data_dir/key.pem"
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
