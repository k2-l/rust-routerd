+fn flush_unauthorized_conntrack(store: &DeviceStore) {
+    let Some(ct) = conntrack_bin() else {
+        return;
+    };
+    let allowed: HashSet<String> = store
+        .allowed_macs()
+        .into_iter()
+        .map(|m| m.to_ascii_lowercase())
+        .collect();
